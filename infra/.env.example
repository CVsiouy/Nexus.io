# Copy this to infra/.env and fill it in. That file is gitignored — it holds
# your real domains and must never be committed.
#
#   cp infra/.env.example infra/.env

# ── Required ────────────────────────────────────────────────────────────────

# Where Let's Encrypt sends certificate-expiry warnings. A real address you read.
ACME_EMAIL=you@example.com

# The domain players' browsers open a WebSocket to. Must have a DNS A record
# pointing at this server BEFORE you deploy, or TLS cannot be issued.
SERVER_DOMAIN=eu1.example.com

# Which website is allowed to connect. Comma-separated, no trailing slash.
# Without this anyone can host a copy of the client, point it here, and you pay
# for their bandwidth.
ALLOWED_ORIGINS=https://example.com,https://www.example.com

# ── Optional ────────────────────────────────────────────────────────────────

# Set ONLY if you are self-hosting the frontend on this box instead of using a
# CDN. Leave unset for the recommended Cloudflare Pages setup.
# FRONTEND_DOMAIN=example.com

# Identifies this machine in logs and metrics. Give each server a distinct name.
NODE_NAME=node1
REGION=eu

# debug | info | warn | error
LOG_LEVEL=info

# Resource caps for the server container.
SERVER_CPUS=2.0
SERVER_MEMORY=1g

# Image tag, for rolling back: TAG=v3 ./infra/deploy.sh
TAG=latest

# Error reporting (https://sentry.io — free tier is plenty). Leave empty to disable.
SENTRY_DSN=
