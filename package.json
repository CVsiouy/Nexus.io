{
  "name": "nexus-io",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nexus.io — .io strategy game. Monorepo: shared simulation + client (+ server from Phase 1).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @nexus/client",
    "build": "npm run build --workspace @nexus/client",
    "test": "node --test packages/sim/test/ apps/client/test/"
  }
}
