{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@basewar/protocol": ["../../packages/protocol/src/index.ts"],
      "@basewar/sim": ["../../packages/sim/index.js"]
    }
  },
  "include": ["src/**/*.ts"]
}
